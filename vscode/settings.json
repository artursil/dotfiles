{
    "workbench.colorTheme": "Rosé Pine",
    // "saveAndRunExt": {
    //     "commands": [
    //         {
    //             "match": ".*\\.py",
    //             "isShellCommand": false,
    //             "cmd": "autoflake.removeUnused"
    //         },
    //     ]
    // },
    "breadcrumbs.enabled": true,
    "explorer.confirmDelete": false,
    "vim.easymotion": true,
    "vim.useCtrlKeys": true,
    "vim.leader": "<space>",
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-p>": false,
    },
    "editor.minimap.enabled": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,
    "editor.rulers": [120],
    "python.linting.flake8Args": [
        "--max-line-length=120"
    ],
    "keyboard.dispatch": "keyCode",
    "autoDocstring.docstringFormat": "google",
    "files.trimTrailingWhitespace": true,
    "editor.fontSize": 18,
    "window.menuBarVisibility": "default",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "editor.cursorStyle": "line",
    "editor.lineNumbers": "on",
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.wordWrap": "off",
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": [
                ">"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
    ],
    // "vim.normalModeKeyBindingsNonRecursive": [
    //     {
    //         "before": [";"],
    //         "after": ["l"]
    //     },
    //     {
    //         "before": ["l"],
    //         "after": ["k"]
    //     },
    //     {
    //         "before": ["k"],
    //         "after": ["j"]
    //     },
    //     {
    //         "before": ["j"],
    //         "after": ["h"]
    //     },
    // ],
    // "vim.visualModeKeyBindingsNonRecursive": [
    //     {
    //         "before": [";"],
    //         "after": ["l"]
    //     },
    //     {
    //         "before": ["l"],
    //         "after": ["k"]
    //     },
    //     {
    //         "before": ["k"],
    //         "after": ["j"]
    //     },
    //     {
    //         "before": ["j"],
    //         "after": ["h"]
    //     },
    //     {
    //         "before": [
    //             "p",
    //         ],
    //         "after": [
    //             "p",
    //             "g",
    //             "v",
    //             "y"
    //         ]
    //     }
    // ],
    "git.enableSmartCommit": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "isort.args": [
        "--profile",
        "black"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnType": true
    },
    "workbench.startupEditor": "none",
    "window.zoomLevel": -2,
    "update.mode": "manual",
    "files.autoSave": "onFocusChange",
    "python.envFile": "${workspaceFolder}/.env",
    "remote.autoForwardPortsSource": "hybrid",
    "zenMode.hideLineNumbers": false,
    "zenMode.showTabs": "none",
    "zenMode.centerLayout": false,
    "zenMode.hideStatusBar": false,
    "git.detectWorktrees": true,
    "claudeCode.preferredLocation": "panel",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "mermaidViewer.useVSCodeTheme": false,
    "mermaidViewer.theme": "neutral",
    "mermaidViewer.previewAppearance": "light",
    // Ctrl+F in the terminal goes to the shell instead of opening the terminal find box
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.terminal.focusFind"
    ],
}